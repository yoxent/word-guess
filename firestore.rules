rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(playerId) {
      return signedIn() && request.auth.uid == playerId;
    }

    function isLeaderboardType(type) {
      return type in [
        'daily_streak',
        'endless_streak',
        'endless_total',
        'best_streak',
        'sharpshooter',
      ];
    }

    match /playerStats/{playerId} {
      allow read, write: if isOwner(playerId);
    }

    // Admin SDK (Cloud Functions) bypasses these rules. Clients must not write Pro.
    match /entitlements/{playerId} {
      allow read: if isOwner(playerId);
      allow write: if false;
    }

    match /leaderboards/{leaderboardType}/scores/{playerId} {
      allow get, list: if isLeaderboardType(leaderboardType);
      allow write: if false;
    }

    match /leaderboardReceipts/{playerId} {
      allow read, write: if false;

      match /games/{sessionId} {
        allow read, write: if false;
      }
    }
  }
}
